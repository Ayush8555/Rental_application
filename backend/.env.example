# Copy to .env for local work. Real values for staging/production live only on
# the servers and in the company password manager (never in git).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development            # development | test | staging | production
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:4000      # public URL of this API
PUBLIC_WEB_URL=http://localhost:4000    # www site (share links, legal pages)
ADMIN_ORIGIN=http://localhost:5173      # admin panel origin, the only CORS origin allowed
TRUST_PROXY=false                       # true behind Caddy/nginx/Cloudflare

# Database: the app user must NOT be a superuser (see infra/postgres/roles.sql)
DATABASE_URL=postgresql://rentnook_app:change-me@localhost:5432/rentnook
# Owner role used only by `prisma migrate deploy`
MIGRATION_DATABASE_URL=postgresql://rentnook_owner:change-me@localhost:5432/rentnook
REDIS_URL=redis://:change-me@localhost:6379

# Secrets: 64+ random characters each outside development
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=rentnook-api
JWT_AUDIENCE=rentnook-app
REFRESH_TOKEN_PEPPER=change-me-change-me-change-me-change-me
ADMIN_SESSION_SECRET=change-me-change-me-change-me-change-me
CSRF_SECRET=change-me-change-me-change-me-change-me
TOTP_ENC_KEY=base64-of-32-random-bytes-goes-here-xxxxxx=   # randomBytes(32).toString('base64')
URL_SIGNING_SECRET=change-me-change-me-change-me-change-me

# Phone login. "dev" accepts tokens like dev:+919812345678 and is refused on staging/production.
AUTH_PROVIDER=dev                       # dev | firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=          # one-line JSON of the service account key
APP_CHECK_ENFORCE=false                 # must be true in production
FIREBASE_WEB_API_KEY=                   # for the /delete-account web page
FIREBASE_WEB_AUTH_DOMAIN=

# Object storage. "local" writes to STORAGE_LOCAL_DIR and is refused on staging/production.
STORAGE_DRIVER=local                    # local | s3
STORAGE_LOCAL_DIR=./.data/storage
STORAGE_ENDPOINT=                       # e.g. https://<account>.r2.cloudflarestorage.com or MinIO URL
STORAGE_REGION=ap-south-1
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_FORCE_PATH_STYLE=false          # true for MinIO
BUCKET_PHOTOS=photos-dev
BUCKET_PRIVATE_DOCS=private-docs-dev

PUSH_PROVIDER=log                       # log | fcm
CAPTCHA_PROVIDER=off                    # off | turnstile (admin login after 3 failures)
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

ANDROID_PACKAGE=in.rentnook.app
ANDROID_CERT_SHA256=                    # comma separated, upload key + Play signing key
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=in.rentnook.app

ADMIN_IP_ALLOWLIST=                     # optional, comma separated office/home IPs
SENTRY_DSN_BACKEND=
LOG_LEVEL=info

RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_AUTH_IP_PER_MIN=10
RATE_LIMIT_AUTH_DEVICE_PER_MIN=5
RATE_LIMIT_SEARCH_PER_MIN=60
