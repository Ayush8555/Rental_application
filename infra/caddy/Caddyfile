# Automatic HTTPS (Let's Encrypt), HTTP -> HTTPS, TLS 1.2+.
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

(tls_strict) {
	tls {
		protocols tls1.2 tls1.3
	}
}

(common_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-Via
	}
}

# Staging-only extras (basic auth on admin, IP allowlist on the API) live in
# caddy/extra/ on the staging server; production has none. See
# caddy/extra.example/.

# ---------------------------------------------------------------- API + public pages
{$API_HOST}, {$WWW_HOST} {
	import tls_strict
	import common_headers
	import /etc/caddy/extra/api-*.caddy
	encode zstd gzip
	request_body {
		max_size 6MB
	}
	# The API sets its own CSP per page; Caddy only adds the transport headers.
	reverse_proxy api:4000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 30s
		}
	}
}

# ---------------------------------------------------------------- admin panel (static)
{$ADMIN_HOST} {
	import tls_strict
	import common_headers
	import /etc/caddy/extra/admin-*.caddy

	@outside not remote_ip {$ADMIN_ALLOW_IPS}
	respond @outside 404

	root * /srv/admin
	encode zstd gzip
	header {
		# No inline scripts. React escapes text; this stops anything that slips through.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://{$API_HOST}; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
